modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["gtk4", "pango", "glib", "cairo", "harfbuzz", "gdk-pixbuf", "vulkan-loader", "graphene", "icu", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "flite", "libwebp", "libavif", "libepoxy", "libjpeg", "wayland", "enchant", "mesa", "libsecret", "libxkbcommon", "x264", "xorg.libX11", "atk", "libmanette", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-libav", "icu74", "gcc", "hyphen", "libjpeg8", "libgbm", "libjxl", "libsoup_3"]
